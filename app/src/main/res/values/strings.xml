    <!-- Always-on location -->
    <string name="settings_tracking">Live location</string>
    <string name="settings_tracking_body">Share where you are continuously, so they can see it even when your phone is in your pocket. This uses more battery and there is a permanent notification while it runs.</string>
    <string name="settings_tracking_on">Sharing continuously</string>
    <string name="settings_tracking_off">Only while the app is open</string>
    <string name="permission_background_title">All the time</string>
    <string name="permission_background_body">To keep sharing your location when Filo is closed, Android needs you to choose <b>Allow all the time</b> on the next screen. Nothing else changes, and you can turn this off in Filo whenever you like.</string>
    <string name="permission_precise_title">Precise or approximate</string>
    <string name="permission_precise_body">Precise location shows them the street you are on. Approximate only shows the town. Either works.</string>
