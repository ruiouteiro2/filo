<?xml version="1.0" encoding="utf-8"?>
<!-- The site's card, as a widget ground: dark red-black fade at ~88% opacity so the
     wallpaper breathes, edged with the scarlet 22% hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#E01A090C" android:endColor="#E0090304" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#38E63946" />
</shape>
