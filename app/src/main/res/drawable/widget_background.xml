<?xml version="1.0" encoding="utf-8"?>
<!--
  Widgets sit on somebody's wallpaper, so this is deliberately translucent rather than a
  solid slab: about 84% opacity lets the wallpaper through without letting it fight the text.
  The hairline keeps the shape legible on a light wallpaper, where a dark translucent fill
  alone would lose its edges.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#D6120A0D" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#66B01523" />
</shape>
