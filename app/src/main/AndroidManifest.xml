<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Precise is what makes always-on sharing useful; on API 31+ it is silently ignored
         unless it is requested together with COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Must be requested in its own later call on API 30+, never alongside the above. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ hides other packages unless they are declared here. Without this,
         isInstalled() always says no and the Spotify deep link cannot be targeted. -->
    <queries>
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".FiloApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Filo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Filo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Catches the OAuth redirect from Spotify's consent page. The scheme must match
             the redirect URI registered in the Spotify dashboard exactly. -->
        <activity
            android:name=".spotify.SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Filo">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.filo.app" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- Lets AppCompat persist the per app language on API levels below 33. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
             Reads what is playing from the phone's own media session. Notification access is
             only the key: MediaSessionManager refuses to hand over sessions without an
             enabled listener. This service never implements onNotificationPosted, and
             disabled_filter_types tells the OS not to deliver those callbacks at all, so it
             structurally cannot read messages.
        -->
        <service
            android:name=".nowplaying.NowPlayingListenerService"
            android:exported="false"
            android:label="@string/now_playing_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations|alerting|silent|ongoing" />
        </service>

        <service
            android:name=".location.LiveLocationService"
            android:exported="false"
            android:enabled="true"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <receiver
            android:name=".location.LocationBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.FiloMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_heart" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/crimson" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="filo_ping" />

        <receiver
            android:name=".widget.TogetherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_together_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/together_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HeartWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_heart_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heart_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PhotoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_photo_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photo_widget_info" />
        </receiver>

    </application>
</manifest>
